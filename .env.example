DB_PASSWORD=dein-postgres-passwort
RIOT_API_KEY=dein-riot-api-key
RIOT_NAME=dein-riot-name
RIOT_TAG=deintag

# Schaltet die eigene Besuchsstatistik unter /stats/<secret> frei (leer lassen = kein
# Tracking). Langen zufälligen Wert nehmen, z.B. mit: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ANALYTICS_SECRET=

# Nur fürs Live-Deployment nötig (z.B. Render/Railway setzen diese automatisch, wenn du
# eine Postgres-Datenbank verknüpfst). Lokal einfach weglassen - dann wird DB_PASSWORD
# oben für die lokale Postgres-Verbindung genutzt.
# DATABASE_URL=postgres://user:passwort@host:5432/dbname
# PORT=5050
# FLASK_DEBUG=0
